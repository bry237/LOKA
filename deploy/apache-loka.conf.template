# Vhost LOKA — généré par deploy/provision.sh à partir de ce template.
#
# Le document root est le PARENT du dossier cloné (pas le dossier LOKA
# lui-même) car tout le code applicatif utilise des liens absolus du
# type /LOKA/app/... — exactement comme en local avec XAMPP, où le site
# est servi sous http://localhost/LOKA/. Ça évite de toucher au code.
#
# Après modification de ce fichier (notamment les SetEnv ci-dessous) :
#   sudo systemctl reload apache2

<VirtualHost *:80>
    ServerName CHANGE-MOI.example.com
    DocumentRoot /var/www

    <Directory __APP_DIR__>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>

    # Ne jamais exposer .git, .htaccess, composer.json/lock, vendor/, etc.
    <DirectoryMatch "__APP_DIR__/(\.git|vendor|database|deploy)">
        Require all denied
    </DirectoryMatch>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    # --- Variables d'environnement applicatives ---
    # (voir config/database.php et config/services.php : tout passe par
    # getenv(), rien à modifier côté code)
    SetEnv LOKA_DB_HOST 127.0.0.1
    SetEnv LOKA_DB_PORT 3306
    SetEnv LOKA_DB_NAME loka
    SetEnv LOKA_DB_USER loka_app
    SetEnv LOKA_DB_PASSWORD CHANGE-MOI

    # Laisse "log" tant que tu n'as pas un vrai numéro Vonage vérifié
    # (voir mémoire projet : l'expéditeur alphanumérique est filtré par
    # les opérateurs français) — les codes finissent dans la table
    # `notification` et les logs Apache au lieu de partir par SMS.
    SetEnv SMS_PROVIDER log
    # SetEnv VONAGE_API_KEY CHANGE-MOI
    # SetEnv VONAGE_API_SECRET CHANGE-MOI
    # SetEnv VONAGE_FROM CHANGE-MOI

    # SetEnv STRIPE_SECRET_KEY sk_live_ou_test_CHANGE-MOI
    # SetEnv STRIPE_PUBLISHABLE_KEY pk_live_ou_test_CHANGE-MOI
    # SetEnv STRIPE_WEBHOOK_SECRET whsec_CHANGE-MOI

    # SetEnv ANTHROPIC_API_KEY CHANGE-MOI

    ErrorLog ${APACHE_LOG_DIR}/loka-error.log
    CustomLog ${APACHE_LOG_DIR}/loka-access.log combined
</VirtualHost>

# Une fois un nom de domaine pointé ici et certbot installé :
#   sudo certbot --apache -d CHANGE-MOI.example.com
# certbot ajoutera automatiquement un bloc <VirtualHost *:443> au-dessus.
